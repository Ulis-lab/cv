{
  "name": "createur-cv-ulis",
  "version": "0.4.0",
  "description": "Créateur de CV pour élèves — formulaire + aperçu + export PPTX/PDF",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "author": "Yo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "fr.ulis.createurcv",
    "productName": "Createur de CV - Beta 0.4.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "vendor/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CreateurCV-Beta0.4.0-Portable.${ext}",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "CreateurCV-Beta0.4.0-Portable.${ext}"
    }
  }
}
